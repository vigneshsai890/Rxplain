# Copy to `.env` for local development. `.env` is gitignored and must never be
# committed. Every field below maps 1:1 to an attribute of app.config.Settings,
# which forbids unknown keys - a typo here fails startup instead of being
# silently ignored.

# One of: local | test | staging | production
APP_ENV=local

# One of: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# TCP port the ASGI server binds on 0.0.0.0. Cloud Run injects this.
PORT=8080

# --- response hardening ------------------------------------------------------
# data: is allowed for images only, so the result page can inline the cropped
# prescription snippet backing each fact without a second request.
CONTENT_SECURITY_POLICY=default-src 'self'; img-src 'self' data:; form-action 'self'
HSTS_MAX_AGE_SECONDS=63072000
REFERRER_POLICY=no-referrer

# --- storage -----------------------------------------------------------------
# Credentials live only here. Matches docker-compose.yml for local development.
DATABASE_URL=postgresql://rxplain:rxplain_local_dev@127.0.0.1:55432/rxplain
DATABASE_POOL_MIN_SIZE=1
DATABASE_POOL_MAX_SIZE=8

# --- ingestion ---------------------------------------------------------------
MAX_UPLOAD_BYTES=10485760
# Relative paths are resolved against the installation root, not the working
# directory. The container overrides these to their in-image locations.
OCR_FIXTURE_DIR=tests/golden/ocr
SAMPLE_PRESCRIPTION_DIR=tests/golden/prescriptions

# --- data locations ----------------------------------------------------------
# Applied at startup. The committed RxNorm seed is loaded on first run when the
# concept table is empty.
MIGRATIONS_DIR=migrations
RXNORM_SEED_PATH=migrations/seed/rxnorm_seed.json

# --- safety gates ------------------------------------------------------------
# Documents whose mean token confidence falls below the first value are
# rejected outright; individual tokens below the second are flagged.
OCR_MIN_MEAN_CONFIDENCE=0.80
OCR_MIN_TOKEN_CONFIDENCE=0.60

# Verbatim traceability of dose/frequency text back to OCR spans. Values below
# 0.90 are rejected by validation: this threshold may only be tightened.
VERBATIM_MIN_SIMILARITY=0.90

# Trigram similarity required by the RxNorm approximate-match tier.
RXNORM_MIN_SIMILARITY=0.85

# --- transcription -----------------------------------------------------------
# One nvapi- key authenticates every model on this endpoint; you select the
# model per request. Leave NVIDIA_API_KEY unset to use the committed fixtures
# instead, which is what CI does.
# NVIDIA_API_KEY=nvapi-...
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_VISION_MODEL=meta/llama-3.2-11b-vision-instruct
NVIDIA_TEXT_MODEL=mistralai/mistral-nemotron
NVIDIA_TIMEOUT_SECONDS=120.0

# Confidence given to vision-transcribed words. Not measured values: the model
# marks words it is unsure of, and the unsure figure sits below
# OCR_MIN_TOKEN_CONFIDENCE so those medications are withheld.
VISION_CONFIDENT_TOKEN_CONFIDENCE=0.90
VISION_UNSURE_TOKEN_CONFIDENCE=0.45

# --- openFDA -----------------------------------------------------------------
# Public API, no key required (rate limited per IP).
OPENFDA_BASE_URL=https://api.fda.gov
OPENFDA_TIMEOUT_SECONDS=20.0
OPENFDA_CACHE_TTL_HOURS=168
OPENFDA_ENABLED=true
