{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "runtime": "python3.12",
        "maxLambdaSize": "50mb",
        "includeFiles": [
          "app/web/templates/**",
          "app/web/static/**",
          "tests/golden/ocr/**",
          "tests/golden/prescriptions/**",
          "migrations/seed/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ],
  "env": {
    "STORAGE_BACKEND": "memory",
    "OCR_FIXTURE_DIR": "tests/golden/ocr",
    "SAMPLE_PRESCRIPTION_DIR": "tests/golden/prescriptions",
    "RXNORM_SEED_PATH": "migrations/seed/rxnorm_seed.json",
    "APP_ENV": "production",
    "LOG_LEVEL": "INFO"
  }
}
